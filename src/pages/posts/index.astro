---
import BackToPostsBar from "@/components/BackToPostsBar.astro"
import PostArchive from "@/components/PostArchive.astro"
import { navigation, site } from "@/config"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getPosts } from "@/lib/posts"

const posts = await getPosts()
const summary = posts.length > 0 ? `共 ${posts.length} 篇` : "还没有文章"
// meta description 要给 Google 一句有信息量的站点介绍；「共 N 篇」这种
// 计数文字当 description 会被搜索结果原样照搬或改写，只留在页面正文里
const description =
  "Ad_closeNN 的全部文章归档：建站部署、域名邮箱、网络与浏览器等技术折腾与记录，按时间倒序排列。"

const jsonLd = {
  "@type": "CollectionPage",
  name: "文章归档",
  description,
  url: `${site.url}/posts/`,
  isPartOf: {
    "@type": "Blog",
    name: site.name,
    url: site.url,
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/posts/${post.id}/`,
      name: post.data.title,
    })),
  },
}
---

<BaseLayout
  title="归档"
  description={description}
  ogType="website"
  ogImage={site.iconSrc}
  jsonLd={jsonLd}
  mainClass="is-archive-page"
  breadcrumbLabel="归档"
>
  <BackToPostsBar href={navigation.home.href} label="返回首页" />

  <section class="archive-page-header">
    <div class="archive-page-heading">
      <h1>归档</h1>
      <p>{summary}</p>
    </div>
  </section>

  <PostArchive posts={posts} />
</BaseLayout>
