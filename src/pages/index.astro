---
import { buttonVariants } from "@/components/ui/button"
import { navigation, profile, site } from "@/config"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { cn } from "@/lib/utils"

const jsonLd = {
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description,
  author: {
    "@type": "Person",
    name: site.shortName,
    url: site.url,
  },
}
---

<BaseLayout
  description={site.description}
  ogType="website"
  ogImage={site.avatarSrc}
  jsonLd={jsonLd}
>
  <section
    class="home-hero mx-auto grid min-h-[calc(100vh-220px)] content-center justify-items-center gap-4 text-center"
  >
    <span class="home-avatar-wrap relative inline-block size-36 rounded-full">
      <img
        class="size-full rounded-full border-2 border-border object-cover select-none"
        src={site.avatarSrc}
        alt={`${site.shortName} 的头像`}
        width="144"
        height="144"
        draggable="false"
      />
      <span class="home-online-dot" aria-hidden="true"></span>
    </span>
    <h1 class="mt-1 mb-0 font-heading text-3xl font-semibold tracking-tight">
      {site.shortName}
    </h1>
    <p class="eyebrow">个人博客</p>
    <p class="m-0 max-w-md text-base leading-relaxed text-muted-foreground">
      {profile.bio}
    </p>
    <div class="mt-3 flex w-full max-w-md">
      <a
        href={navigation.posts.href}
        class={cn(buttonVariants({ size: "lg" }), "w-full")}
      >
        阅读文章
      </a>
    </div>
  </section>
</BaseLayout>
