---
import HomePagination from "@/components/HomePagination.astro"
import PostTimeline from "@/components/PostTimeline.astro"
import SidebarStats from "@/components/SidebarStats"
import TaxonomyPanel from "@/components/TaxonomyPanel.astro"
import { links, profile, site } from "@/config"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getBuildCommit } from "@/lib/build-commit"
import { HOME_PAGE_SIZE, getPosts } from "@/lib/posts"

const posts = await getPosts()
const buildCommit = getBuildCommit()
const summary = posts.length > 0 ? `共 ${posts.length} 篇文章` : "还没有文章"

// Fuwari 式 JS 分页：全部页的卡片元数据都进初始 HTML（无正文，SEO 无损），
// 页码切换由脚本切换 data-home-timeline-page 容器显示，不产生路由跳转
const chunks = Array.from(
  { length: Math.max(Math.ceil(posts.length / HOME_PAGE_SIZE), 1) },
  (_, i) => posts.slice(i * HOME_PAGE_SIZE, (i + 1) * HOME_PAGE_SIZE)
)
const totalPages = chunks.length

const jsonLd = {
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description,
  author: {
    "@type": "Person",
    name: site.shortName,
    url: site.url,
    sameAs: [links.me.href, links.github.href, links.x.href],
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/posts/${post.id}/`,
      name: post.data.title,
    })),
  },
}
---

<BaseLayout
  description={site.description}
  ogType="website"
  ogImage={site.homeBanner.src}
  jsonLd={jsonLd}
  mainClass="is-home-feed"
>
  <section
    class="home-banner"
    data-home-hero
    aria-labelledby="home-profile-name"
  >
    <img
      class="home-banner-image"
      src={site.homeBanner.src}
      alt=""
      width="1920"
      height="1369"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${site.homeBanner.position}`}
    />
    <div class="home-banner-scrim" aria-hidden="true"></div>
    <div class="home-profile">
      <img
        class="home-profile-avatar"
        src={profile.avatar}
        alt={`${profile.name} 的头像`}
        width="128"
        height="128"
        draggable="false"
      />
      <h1 id="home-profile-name">{site.name}</h1>
      <p>{profile.bio}</p>
    </div>
  </section>

  <section
    class="home-feed-panel"
    aria-label="文章列表"
    data-home-feed-panel
  >
    <header class="home-feed-header">
      <p>{summary}</p>
    </header>

    <div class="posts-layout-grid">
      <div class="posts-layout-main">
        {chunks.map((chunk, i) => (
          <div
            class="home-timeline-page"
            data-home-timeline-page={i + 1}
            hidden={i > 0}
          >
            <PostTimeline posts={chunk} />
          </div>
        ))}
        <HomePagination currentPage={1} totalPages={totalPages} />
      </div>
      <aside class="posts-layout-right" aria-label="侧栏">
        <div class="flex flex-col gap-6">
          <TaxonomyPanel posts={posts} />
          <SidebarStats client:load commit={buildCommit} />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
