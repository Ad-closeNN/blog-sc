---
import HomePagination from "@/components/HomePagination.astro"
import PostTimeline from "@/components/PostTimeline.astro"
import SidebarStats from "@/components/SidebarStats"
import SiteNotice from "@/components/SiteNotice.astro"
import TaxonomyPanel from "@/components/TaxonomyPanel.astro"
import { links, noticeConfig, profile, site } from "@/config"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getBuildCommit } from "@/lib/build-commit"
import { HOME_PAGE_SIZE, getPosts } from "@/lib/posts"
import {
  CameraIcon,
  ExternalLinkIcon,
  LandmarkIcon,
  MapPinIcon,
} from "lucide-react"

const posts = await getPosts()
const buildCommit = getBuildCommit()
const summary = posts.length > 0 ? `共 ${posts.length} 篇文章` : "还没有文章"
// Fuwari 式 JS 分页：文章卡片完整进入初始 HTML（无正文，SEO 无损），
// 客户端按当前筛选结果动态切页，筛选后可从第 1 页重新分页。
const totalPages = Math.max(Math.ceil(posts.length / HOME_PAGE_SIZE), 1)

const homeBannerIcons = {
  "map-pin": MapPinIcon,
  camera: CameraIcon,
  landmark: LandmarkIcon,
} as const
const HomeBannerIcon =
  homeBannerIcons[
    site.homeBanner.badge.icon as keyof typeof homeBannerIcons
  ] ?? MapPinIcon

const jsonLd = {
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description,
  author: {
    "@type": "Person",
    name: site.shortName,
    url: site.url,
    sameAs: [links.me.href, links.github.href, links.x.href],
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/posts/${post.id}/`,
      name: post.data.title,
    })),
  },
}
---

<BaseLayout
  description={site.description}
  ogType="website"
  ogImage={site.homeBanner.src}
  jsonLd={jsonLd}
  mainClass="is-home-feed"
>
  <section
    class="home-banner"
    data-home-hero
    aria-labelledby="home-profile-name"
  >
    <img
      class="home-banner-image"
      src={site.homeBanner.src}
      alt=""
      width="1920"
      height="1369"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${site.homeBanner.position}`}
    />
    <div class="home-banner-scrim" aria-hidden="true"></div>
    <div class="home-profile">
      <img
        class="home-profile-avatar"
        src={profile.avatar}
        alt={`${profile.name} 的头像`}
        width="128"
        height="128"
        draggable="false"
      />
      <h1 id="home-profile-name">{site.name}</h1>
      <p>{profile.bio}</p>
    </div>
    <a
      class="home-banner-badge"
      href={site.homeBanner.badge.href}
      target="_blank"
      rel="noreferrer"
      aria-label={`在新标签页打开 ${site.homeBanner.badge.label} 的地图位置`}
    >
      <HomeBannerIcon className="size-3.5" aria-hidden="true" />
      <span>{site.homeBanner.badge.label}</span>
      <ExternalLinkIcon className="size-3" aria-hidden="true" />
    </a>
  </section>

  <section
    class="home-feed-panel"
    aria-label="文章列表"
    data-home-feed-panel
  >
    {noticeConfig.enable && <SiteNotice />}

    <header class="home-feed-header">
      <p>{summary}</p>
    </header>

    <div class="posts-layout-grid">
      <div class="posts-layout-main">
        <PostTimeline posts={posts} />
        <HomePagination currentPage={1} totalPages={totalPages} />
      </div>
      <aside class="posts-layout-right" aria-label="侧栏">
        <div class="flex flex-col gap-6">
          <TaxonomyPanel posts={posts} />
          <SidebarStats client:load commit={buildCommit} />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
