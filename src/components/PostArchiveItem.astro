---
import { formatShortDate, postHref, type Post } from "@/lib/posts"

type Props = {
  post: Post
}

const { post } = Astro.props
---

<li class="post-archive-item">
  <a class="post-archive-link" href={postHref(post.id)}>
    {/* 归档页不输出机器可读日期：Google 会把第一条 <time> 当成整页日期 */}
    <span class="post-archive-date">{formatShortDate(post.data.published)}</span>
    <span class="post-archive-rail" aria-hidden="true">
      <span class="post-archive-dot"></span>
    </span>
    <span class="post-archive-title">
      {
        (post.data.pinned || post.data.outdated) && (
          <span class="post-archive-statuses">
            {post.data.pinned && (
              <span class="post-archive-pill is-pinned">置顶</span>
            )}
            {post.data.outdated && (
              <span class="post-archive-pill is-outdated">已失效</span>
            )}
          </span>
        )
      }
      <span class="post-archive-title-text">{post.data.title}</span>
    </span>
    {
      post.data.tags.length > 0 && (
        <span class="post-archive-tags">
          {post.data.tags.map((tag) => `#${tag}`).join(" ")}
        </span>
      )
    }
  </a>
</li>
