---
import { footer, site } from "@/config"
import { getTotalWords } from "@/lib/posts"

const totalWords = await getTotalWords()
const formattedTotalWords = totalWords.toLocaleString("zh-CN")
const githubRepoUrl = `https://github.com/${site.githubRepo}`
---

<footer class="site-footer border-t border-border">
  <div
    class="mx-auto flex w-[min(1120px,calc(100%_-_32px))] flex-col gap-6 pt-12 pb-10 max-[640px]:w-[calc(100%_-_24px)] max-[640px]:pt-9 max-[640px]:pb-8"
  >
    <div
      class="flex items-center justify-between max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-3"
    >
      <p class="m-0 font-mono text-xs text-muted-foreground">
        {site.copyright}
      </p>
      <a
        class="footer-back"
        href="#"
        onclick="const r=window.matchMedia('(prefers-reduced-motion: reduce)').matches;window.scrollTo({top:0,behavior:r?'auto':'smooth'});return false"
      >
        回到顶部 ↑
      </a>
    </div>

    <!-- 备案 / RSS / Sitemap / 开源 / 字数 / 驱动 / Cloudflare -->
    <div
      class="flex flex-col items-center gap-3 text-center max-[640px]:gap-4"
    >
      <p
        class="footer-meta-line m-0 font-mono text-xs leading-relaxed text-muted-foreground"
      >
        <a
          class="footer-meta-link"
          href={footer.beian.tea.href}
          target="_blank"
          rel="noopener noreferrer"
          >{footer.beian.tea.text}</a
        >
        <span class="footer-meta-sep" aria-hidden="true">·</span>
        <a
          class="footer-meta-link"
          href={footer.beian.moe.href}
          target="_blank"
          rel="noopener noreferrer"
          >{footer.beian.moe.text}</a
        >
        <span class="footer-meta-sep" aria-hidden="true">·</span>
        <span class="footer-meta-item">
          <a class="footer-meta-link" href={footer.rssHref}>RSS</a>
          <span class="mx-1" aria-hidden="true">/</span>
          <a
            class="footer-meta-link"
            href={footer.sitemapHref}
            target="_blank"
            rel="noopener noreferrer"
            >Sitemap</a
          >
        </span>
        <span class="footer-meta-sep" aria-hidden="true">·</span>
        <span class="footer-meta-item">
          博客代码<a
            class="footer-meta-link"
            href={githubRepoUrl}
            target="_blank"
            rel="noopener noreferrer"
            >{footer.openSource.text}</a
          >
        </span>
      </p>
      <p
        class="footer-meta-line m-0 font-mono text-xs leading-relaxed text-muted-foreground"
      >
        <span class="footer-meta-item">总计 {formattedTotalWords} 字</span>
        <span class="footer-meta-sep" aria-hidden="true">·</span>
        <span class="footer-meta-item"
          >由<a
            class="footer-meta-link"
            href={footer.driver.astro.href}
            target="_blank"
            rel="noopener noreferrer"
            > {footer.driver.astro.text} </a
          >驱动</span
        >
        <span class="footer-meta-sep" aria-hidden="true">·</span>
        <a
          class="footer-meta-link"
          href={footer.cloudflare.href}
          target="_blank"
          rel="noopener noreferrer"
          >{footer.cloudflare.text}</a
        >
      </p>
      <img
        src="https://www.cloudflare-cn.com/img/logo-cloudflare-dark.svg"
        alt="Cloudflare"
        loading="lazy"
        draggable="false"
        class="h-[30px] w-auto select-none"
        style="user-select: none; -webkit-user-drag: none"
      />
    </div>
  </div>
</footer>
