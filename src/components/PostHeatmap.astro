---
import { buildHeatmap, type Post } from "@/lib/posts"

type Props = {
  posts: Post[]
}

type HeatmapCellView = {
  date: string
  count: number
  level: number
  future: boolean
  isCurrentYear: boolean
  label: string
}

const { posts } = Astro.props
const { weeks, monthLabels, year } = buildHeatmap(posts)

const today = new Date().toISOString().slice(0, 10)
const weekdayFormatter = new Intl.DateTimeFormat("zh-CN", {
  weekday: "long",
  timeZone: "UTC",
})

function formatCellLabel(date: string, count: number) {
  const [y, month, day] = date.split("-").map(Number)
  const weekday = weekdayFormatter.format(new Date(Date.UTC(y, month - 1, day)))
  return `${y}年${month}月${day}日 ${weekday}，${count} 篇文章`
}

function levelOf(count: number) {
  return Math.min(4, Math.max(0, count))
}

const yearStart = `${year}-01-01`
const yearEnd = `${year}-12-31`

const weekViews = weeks.map((week) =>
  week.map((cell) => {
    const isOutOfBounds = cell.date < yearStart || cell.date > yearEnd
    return {
      ...cell,
      level: isOutOfBounds ? 0 : levelOf(cell.count),
      future: cell.date > today,
      isOutOfBounds,
      label: formatCellLabel(cell.date, cell.count),
    }
  })
)

const allCells = weekViews.flat()

// 仅统计当年 (1月1日 UTC+8 起) 且截至目前的数据
const currentYearCells = allCells.filter(
  (cell) => !cell.isOutOfBounds && !cell.future
)
const activeCells = currentYearCells.filter((cell) => cell.count > 0)
const total = activeCells.reduce((sum, cell) => sum + cell.count, 0)
const busiestCount = activeCells.reduce(
  (highest, cell) => Math.max(highest, cell.count),
  0
)

let longestStreak = 0
let runningStreak = 0
for (const cell of currentYearCells) {
  runningStreak = cell.count > 0 ? runningStreak + 1 : 0
  longestStreak = Math.max(longestStreak, runningStreak)
}

// 单排整年布局（GitHub 风格）：53 列小格子，底部全宽展示
const monthMarkers = monthLabels[0].flatMap((month, index) =>
  month ? [{ ...month, column: index + 1 }] : []
)

const weekdays = [
  { row: 2, label: "一" },
  { row: 4, label: "三" },
  { row: 6, label: "五" },
]

const descriptionId = `heatmap-description-${year}`
---

<section class="heatmap-card" aria-labelledby={`${descriptionId}-title`}>
  <!-- Header -->
  <div class="heatmap-header">
    <div class="heatmap-header-main">
      <div class="heatmap-badge">
        <svg
          class="heatmap-badge-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
          ></path></svg
        >
        <span class="heatmap-badge-text">{year} 写作记录</span>
      </div>
      <h2 id={`${descriptionId}-title`} class="heatmap-title">
        当年已发布 <strong class="heatmap-count-highlight">{total}</strong> 篇文章
      </h2>
    </div>
  </div>

  <!-- Stats Grid Badges -->
  <div class="heatmap-stats-grid" aria-label="当年写作活跃度摘要">
    <div class="heatmap-stat-card">
      <div class="heatmap-stat-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
            width="18"
            height="18"
            x="3"
            y="4"
            rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"
          ></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path
            d="M8 18h.01"></path><path d="M12 18h.01"></path><path
            d="M16 18h.01"></path></svg
        >
      </div>
      <div class="heatmap-stat-info">
        <span class="heatmap-stat-label">活跃天数</span>
        <span class="heatmap-stat-value"
          >{activeCells.length} <span class="heatmap-stat-unit">天</span></span
        >
      </div>
    </div>
    <div class="heatmap-stat-card">
      <div class="heatmap-stat-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
          ></path></svg
        >
      </div>
      <div class="heatmap-stat-info">
        <span class="heatmap-stat-label">最长连击</span>
        <span class="heatmap-stat-value"
          >{longestStreak} <span class="heatmap-stat-unit">天</span></span
        >
      </div>
    </div>
    <div class="heatmap-stat-card">
      <div class="heatmap-stat-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
          ></path></svg
        >
      </div>
      <div class="heatmap-stat-info">
        <span class="heatmap-stat-label">单日峰值</span>
        <span class="heatmap-stat-value"
          >{busiestCount} <span class="heatmap-stat-unit">篇</span></span
        >
      </div>
    </div>
  </div>

  <p id={descriptionId} class="sr-only">
    热力图展示 {year} 年从 1 月 1 日开始的每日发文记录，颜色越深或越亮表示当天发布文章越多。
  </p>

  <!-- Heatmap Graph (Single-Row Full-Year, GitHub Style) -->
  <div class="heatmap-sections">
    <div class="heatmap-section">
      <div class="heatmap-graph-inner">
        <div class="heatmap-weekdays" aria-hidden="true">
          {
            weekdays.map((wd) => (
              <span style={`grid-row: ${wd.row}`} class="heatmap-weekday">
                {wd.label}
              </span>
            ))
          }
        </div>

        <div class="heatmap-main-grid">
          <div
            class="heatmap-months"
            style={`--heatmap-columns: ${weeks.length}`}
            aria-hidden="true"
          >
            {
              monthMarkers.map((month) => (
                <span style={`grid-column-start: ${month.column}`}>
                  {month.label}
                </span>
              ))
            }
          </div>

          <div
            class="heatmap-grid"
            style={`--heatmap-columns: ${weeks.length}`}
            role="grid"
            aria-label={`${year}年 每日发文数量`}
          >
            {
              weekViews
                .flat()
                .map((cell) => (
                  <span
                    class="heatmap-cell"
                    role={cell.isOutOfBounds ? undefined : "gridcell"}
                    tabindex={
                      !cell.isOutOfBounds && !cell.future && cell.count > 0
                        ? 0
                        : undefined
                    }
                    data-level={cell.isOutOfBounds ? undefined : cell.level}
                    data-date={cell.isOutOfBounds ? undefined : cell.date}
                    data-count={cell.isOutOfBounds ? undefined : cell.count}
                    data-label={cell.isOutOfBounds ? undefined : cell.label}
                    data-future={cell.future ? "true" : undefined}
                    data-out-of-bounds={cell.isOutOfBounds ? "true" : undefined}
                    aria-label={
                      cell.isOutOfBounds || cell.future ? undefined : cell.label
                    }
                    aria-hidden={
                      cell.isOutOfBounds || cell.future ? "true" : undefined
                    }
                  />
                ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Legend & Details -->
  <div class="heatmap-footer">
    <div class="heatmap-legend" aria-label="发文数量色阶">
      <span class="heatmap-legend-label">较少</span>
      {
        [0, 1, 2, 3, 4].map((level) => (
          <span
            class="heatmap-cell"
            data-level={level}
            aria-label={level === 4 ? "4 篇及以上" : `${level} 篇`}
          />
        ))
      }
      <span class="heatmap-legend-label">较多</span>
    </div>

    <details class="heatmap-details">
      <summary class="heatmap-details-trigger">
        <span>当年明细</span>
        <svg
          class="heatmap-chevron"
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
        >
      </summary>
      <div class="heatmap-table-wrap">
        <table>
          <caption class="sr-only">{year} 年有文章发布的日期</caption>
          <thead>
            <tr>
              <th scope="col">日期</th>
              <th scope="col">文章篇数</th>
            </tr>
          </thead>
          <tbody>
            {
              activeCells.toReversed().map((cell) => (
                <tr>
                  <th scope="row">{cell.date}</th>
                  <td>
                    <span class="heatmap-table-count">{cell.count} 篇</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>
  </div>

  <!-- Dynamic Floating Tooltip -->
  <div class="heatmap-tooltip" role="tooltip" hidden>
    <div class="heatmap-tooltip-content">
      <strong class="heatmap-tooltip-count"></strong>
      <span class="heatmap-tooltip-date font-mono"></span>
    </div>
  </div>
</section>

<script>
  function initializeHeatmaps() {
    document
      .querySelectorAll<HTMLElement>(".heatmap-card")
      .forEach((heatmap) => {
        if (heatmap.dataset.ready === "true") return
        heatmap.dataset.ready = "true"

        const grids = heatmap.querySelectorAll<HTMLElement>(".heatmap-grid")
        const tooltip = heatmap.querySelector<HTMLElement>(".heatmap-tooltip")
        const tooltipValue = tooltip?.querySelector(".heatmap-tooltip-count")
        const tooltipDate = tooltip?.querySelector(".heatmap-tooltip-date")
        if (grids.length === 0 || !tooltip || !tooltipValue || !tooltipDate)
          return

        let activeCell: HTMLElement | null = null

        const positionTooltip = (cell: HTMLElement) => {
          const cellRect = cell.getBoundingClientRect()
          const heatmapRect = heatmap.getBoundingClientRect()
          const tooltipRect = tooltip.getBoundingClientRect()
          const gap = 8
          const left = Math.min(
            heatmapRect.width - tooltipRect.width - 8,
            Math.max(
              8,
              cellRect.left -
                heatmapRect.left +
                cellRect.width / 2 -
                tooltipRect.width / 2
            )
          )
          const above =
            cellRect.top - heatmapRect.top - tooltipRect.height - gap
          const top =
            above > 0 ? above : cellRect.bottom - heatmapRect.top + gap

          tooltip.style.left = `${left}px`
          tooltip.style.top = `${top}px`
        }

        const showTooltip = (cell: HTMLElement) => {
          if (
            cell.dataset.future === "true" ||
            cell.dataset.outOfBounds === "true"
          )
            return
          activeCell = cell
          tooltipValue.textContent = `${cell.dataset.count ?? "0"} 篇文章`
          tooltipDate.textContent = cell.dataset.label?.split("，")[0] ?? ""
          tooltip.hidden = false
          positionTooltip(cell)
        }

        const hideTooltip = () => {
          activeCell = null
          tooltip.hidden = true
        }

        grids.forEach((grid) => {
          grid.addEventListener("pointerover", (event) => {
            const cell = (event.target as HTMLElement).closest<HTMLElement>(
              ".heatmap-cell[data-date]"
            )
            if (cell) showTooltip(cell)
          })

          grid.addEventListener("pointermove", () => {
            if (activeCell) positionTooltip(activeCell)
          })

          grid.addEventListener("pointerdown", (event) => {
            if (event.pointerType !== "touch") return
            const cell = (event.target as HTMLElement).closest<HTMLElement>(
              ".heatmap-cell[data-date]"
            )
            if (!cell) return
            showTooltip(cell)
            window.setTimeout(hideTooltip, 2500)
          })

          grid.addEventListener("pointerleave", hideTooltip)
          grid.addEventListener("focusin", (event) => {
            const cell = (event.target as HTMLElement).closest<HTMLElement>(
              ".heatmap-cell[data-date]"
            )
            if (cell) showTooltip(cell)
          })
          grid.addEventListener("focusout", hideTooltip)
        })
      })
  }

  initializeHeatmaps()
  document.addEventListener("astro:page-load", initializeHeatmaps)
</script>
