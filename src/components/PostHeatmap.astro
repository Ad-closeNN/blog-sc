---
import type { HTMLAttributes } from "astro/types"

import { buildHeatmapPayload, type Post } from "@/lib/posts"
import {
  deriveCells,
  summarizeByMonth,
  type HeatmapCellDerived,
} from "@/lib/heatmap-core"

type Props = {
  posts: Post[]
}

const { posts } = Astro.props
const payload = buildHeatmapPayload(posts)
const { today, currentYear, years } = payload

// 默认渲染当年；years 恒含当年（buildHeatmapPayload 保证）
const defaultYear = currentYear
const defaultData = years.find((y) => y.year === defaultYear) ?? years[0]!
const defaultCells = deriveCells(defaultData.year, defaultData.counts, today)
const defaultWeeks = defaultData.weeks
const defaultStats = defaultData.stats
const defaultYearLabel =
  defaultYear === currentYear ? "今年" : `${defaultYear} 年`
const defaultMonthSummaries = summarizeByMonth(defaultCells)

const weekdays = [
  { row: 2, label: "一" },
  { row: 4, label: "三" },
  { row: 6, label: "五" },
]

const descriptionId = `heatmap-description-${defaultYear}`

// 与服务端模板同源的 cell 属性规则；改动必须同步 <script> 里的 cellHTML。
function cellAttrs(cell: HeatmapCellDerived): HTMLAttributes<"span"> {
  const hidden = cell.outOfBounds || cell.future
  return {
    class: "heatmap-cell",
    role: cell.outOfBounds ? undefined : "gridcell",
    tabindex:
      !cell.outOfBounds && !cell.future && cell.count > 0 ? 0 : undefined,
    "data-level": cell.outOfBounds ? undefined : cell.level,
    "data-date": cell.outOfBounds ? undefined : cell.date,
    "data-count": cell.outOfBounds ? undefined : cell.count,
    "data-label": cell.outOfBounds ? undefined : cell.label,
    "data-future": cell.future ? "true" : undefined,
    "data-out-of-bounds": cell.outOfBounds ? "true" : undefined,
    "data-today": cell.today ? "true" : undefined,
    "aria-label": hidden ? undefined : cell.label,
    "aria-hidden": hidden ? "true" : undefined,
  }
}
---

<section class="heatmap-card" aria-labelledby={`${descriptionId}-title`}>
  <!-- Header -->
  <div class="heatmap-header">
    <div class="heatmap-header-main">
      <div class="heatmap-badge">
        <svg
          class="heatmap-badge-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
          ></path></svg
        >
        <span class="heatmap-badge-text"
          ><span class="heatmap-badge-year">{defaultData.year}</span> 写作记录</span
        >
      </div>
      <h2 id={`${descriptionId}-title`} class="heatmap-title">
        <span class="heatmap-title-year">{defaultYearLabel}</span>
        已发布
        <strong class="heatmap-count-highlight heatmap-title-count"
          >{defaultStats.total}</strong
        >
        篇文章
      </h2>
    </div>

    <div class="heatmap-header-actions">
      <label class="sr-only" for="heatmap-year-select">切换年份</label>
      <select id="heatmap-year-select" class="heatmap-year-select">
        {
          years.map((y) => (
            <option value={y.year} selected={y.year === defaultYear}>
              {y.year}
              {y.year === currentYear ? "（今年）" : ""}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <!-- Stats Grid Badges -->
  <div class="heatmap-stats-grid" aria-label="当年写作活跃度摘要">
    <div class="heatmap-stat-card">
      <div class="heatmap-stat-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
            width="18"
            height="18"
            x="3"
            y="4"
            rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"
          ></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path
            d="M8 18h.01"></path><path d="M12 18h.01"></path><path
            d="M16 18h.01"></path></svg
        >
      </div>
      <div class="heatmap-stat-info">
        <span class="heatmap-stat-label">活跃天数</span>
        <span class="heatmap-stat-value"
          ><span class="heatmap-stat-number" data-stat="activeDays"
            >{defaultStats.activeDays}</span
          >
          <span class="heatmap-stat-unit">天</span></span
        >
      </div>
    </div>
    <div class="heatmap-stat-card">
      <div class="heatmap-stat-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
          ></path></svg
        >
      </div>
      <div class="heatmap-stat-info">
        <span class="heatmap-stat-label">最长连击</span>
        <span class="heatmap-stat-value"
          ><span class="heatmap-stat-number" data-stat="longestStreak"
            >{defaultStats.longestStreak}</span
          >
          <span class="heatmap-stat-unit">天</span></span
        >
      </div>
    </div>
    <div class="heatmap-stat-card">
      <div class="heatmap-stat-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
          ></path></svg
        >
      </div>
      <div class="heatmap-stat-info">
        <span class="heatmap-stat-label">单日峰值</span>
        <span class="heatmap-stat-value"
          ><span class="heatmap-stat-number" data-stat="busiestCount"
            >{defaultStats.busiestCount}</span
          >
          <span class="heatmap-stat-unit">篇</span></span
        >
      </div>
    </div>
  </div>

  <p id={descriptionId} class="sr-only heatmap-sr-description">
    热力图展示 {defaultData.year} 年从 1 月 1 日开始的每日发文记录，颜色越深或越亮表示当天发布文章越多。
  </p>

  <!-- Heatmap Graph (Single-Row Full-Year, GitHub Style) -->
  <div class="heatmap-sections">
    <div class="heatmap-section">
      <div class="heatmap-graph-inner">
        <div class="heatmap-weekdays" aria-hidden="true">
          {
            weekdays.map((wd) => (
              <span style={`grid-row: ${wd.row}`} class="heatmap-weekday">
                {wd.label}
              </span>
            ))
          }
        </div>

        <div class="heatmap-main-grid">
          <div
            class="heatmap-months"
            style={`--heatmap-columns: ${defaultWeeks}`}
            aria-hidden="true"
          >
            {
              defaultData.months.map((month) => (
                <span style={`grid-column-start: ${month.col}`}>
                  {month.label}
                </span>
              ))
            }
          </div>

          <div
            class="heatmap-grid"
            style={`--heatmap-columns: ${defaultWeeks}`}
            role="grid"
            aria-label={`${defaultData.year}年 每日发文数量`}
          >
            {defaultCells.map((cell) => <span {...cellAttrs(cell)} />)}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Legend & Details -->
  <div class="heatmap-footer">
    <div class="heatmap-legend" aria-label="发文数量色阶">
      <span class="heatmap-legend-label">较少</span>
      {
        [0, 1, 2, 3, 4].map((level) => (
          <span
            class="heatmap-cell"
            data-level={level}
            aria-label={level === 4 ? "4 篇及以上" : `${level} 篇`}
          />
        ))
      }
      <span class="heatmap-legend-label">较多</span>
    </div>

    <details class="heatmap-details">
      <summary class="heatmap-details-trigger">
        <span>当年明细</span>
        <svg
          class="heatmap-chevron"
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
        >
      </summary>
      <div class="heatmap-table-wrap">
        <table class="heatmap-table">
          <caption class="sr-only">{defaultData.year} 年有文章发布的日期</caption>
          <thead>
            <tr>
              <th scope="col">日期</th>
              <th scope="col">文章篇数</th>
            </tr>
          </thead>
          <tbody>
            {
              defaultMonthSummaries.map((month) => (
                <tr>
                  <th scope="row">{month.key}</th>
                  <td>
                    <span class="heatmap-table-count">{month.total}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>
  </div>

  <!-- Dynamic Floating Tooltip -->
  <div class="heatmap-tooltip" role="tooltip" hidden>
    <div class="heatmap-tooltip-content">
      <strong class="heatmap-tooltip-count"></strong>
      <span class="heatmap-tooltip-date font-mono"></span>
    </div>
  </div>

  <!-- 年份切换数据：紧凑 payload，经 define:vars 内联暴露到 window，
       客户端 bundled script 据此重建网格（绕开 set:html 的 rolldown 解析）。 -->
  <script is:inline define:vars={{ heatmapPayload: payload }}>
    window.__heatmapPayload = heatmapPayload
  </script>
</section>

<script>
  import {
    deriveCells,
    summarizeByMonth,
    type HeatmapCellDerived,
    type HeatmapMonthSummary,
  } from "../lib/heatmap-core"

  type HeatmapPayloadClient = {
    today: string
    currentYear: number
    years: {
      year: number
      weeks: number
      counts: number[]
      months: { col: number; label: string }[]
      stats: {
        activeDays: number
        total: number
        longestStreak: number
        busiestCount: number
      }
    }[]
  }

  // 从 define:vars 内联脚本暴露的 window.__heatmapPayload 读取
  function parseHeatmapData(): HeatmapPayloadClient | null {
    const raw = (window as { __heatmapPayload?: unknown }).__heatmapPayload
    if (!raw) return null
    return raw as HeatmapPayloadClient
  }

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
  }

  // 与服务端模板 cellAttrs 同源的 cell 属性；改动必须同步 frontmatter 的 cellAttrs。
  function cellHTML(cell: HeatmapCellDerived) {
    const hidden = cell.outOfBounds || cell.future
    const attrs: string[] = ['class="heatmap-cell"']
    if (!cell.outOfBounds) attrs.push('role="gridcell"')
    if (!cell.outOfBounds && !cell.future && cell.count > 0)
      attrs.push('tabindex="0"')
    if (!cell.outOfBounds)
      attrs.push(
        `data-level="${cell.level}" data-date="${cell.date}" data-count="${cell.count}" data-label="${escapeHtml(cell.label)}"`
      )
    if (cell.future) attrs.push('data-future="true"')
    if (cell.outOfBounds) attrs.push('data-out-of-bounds="true"')
    if (cell.today) attrs.push('data-today="true"')
    if (!hidden) attrs.push(`aria-label="${escapeHtml(cell.label)}"`)
    if (hidden) attrs.push('aria-hidden="true"')
    // 注意：span 不是 void 元素，不能自闭合，必须显式 </span>
    return `<span ${attrs.join(" ")}></span>`
  }

  // 明细表按月汇总行 HTML（与 frontmatter 的 defaultMonthSummaries 渲染同源）
  function monthSummariesHTML(months: HeatmapMonthSummary[]) {
    return months
      .map(
        (m) =>
          `<tr><th scope="row">${m.key}</th><td><span class="heatmap-table-count">${m.total}</span></td></tr>`
      )
      .join("")
  }

  function initializeHeatmaps() {
    document
      .querySelectorAll<HTMLElement>(".heatmap-card")
      .forEach((heatmap) => {
        if (heatmap.dataset.ready === "true") return
        heatmap.dataset.ready = "true"

        const payload = parseHeatmapData()
        const grids = heatmap.querySelectorAll<HTMLElement>(".heatmap-grid")
        const tooltip = heatmap.querySelector<HTMLElement>(".heatmap-tooltip")
        const tooltipValue = tooltip?.querySelector(".heatmap-tooltip-count")
        const tooltipDate = tooltip?.querySelector(".heatmap-tooltip-date")
        const select =
          heatmap.querySelector<HTMLSelectElement>(".heatmap-year-select")
        if (grids.length === 0 || !tooltip || !tooltipValue || !tooltipDate)
          return

        let activeCell: HTMLElement | null = null

        const positionTooltip = (cell: HTMLElement) => {
          const cellRect = cell.getBoundingClientRect()
          const heatmapRect = heatmap.getBoundingClientRect()
          const tooltipRect = tooltip.getBoundingClientRect()
          const gap = 8
          const left = Math.min(
            heatmapRect.width - tooltipRect.width - 8,
            Math.max(
              8,
              cellRect.left -
                heatmapRect.left +
                cellRect.width / 2 -
                tooltipRect.width / 2
            )
          )
          const above =
            cellRect.top - heatmapRect.top - tooltipRect.height - gap
          const top =
            above > 0 ? above : cellRect.bottom - heatmapRect.top + gap

          tooltip.style.left = `${left}px`
          tooltip.style.top = `${top}px`
        }

        const showTooltip = (cell: HTMLElement) => {
          if (
            cell.dataset.future === "true" ||
            cell.dataset.outOfBounds === "true"
          )
            return
          activeCell = cell
          tooltipValue.textContent = `${cell.dataset.count ?? "0"} 篇文章`
          tooltipDate.textContent = cell.dataset.label?.split("，")[0] ?? ""
          tooltip.hidden = false
          positionTooltip(cell)
        }

        const hideTooltip = () => {
          activeCell = null
          tooltip.hidden = true
        }

        const setStat = (key: string, value: number) => {
          const number = heatmap.querySelector<HTMLElement>(
            `[data-stat="${key}"]`
          )
          if (number) number.textContent = String(value)
        }

        const renderYear = (year: number) => {
          if (!payload) return
          hideTooltip()
          activeCell = null
          const yData = payload.years.find((y) => y.year === year)
          if (!yData) return
          const cells = deriveCells(year, yData.counts, payload.today)

          // 重建网格
          grids.forEach((grid) => {
            grid.style.setProperty("--heatmap-columns", String(yData.weeks))
            grid.setAttribute("aria-label", `${year}年 每日发文数量`)
            grid.innerHTML = cells.map(cellHTML).join("")
          })

          // 重建月份行
          const months = heatmap.querySelector<HTMLElement>(".heatmap-months")
          if (months) {
            months.style.setProperty("--heatmap-columns", String(yData.weeks))
            months.innerHTML = yData.months
              .map(
                (m) =>
                  `<span style="grid-column-start:${m.col}">${m.label}</span>`
              )
              .join("")
          }

          // 标题 / badge / sr-only 描述
          const badgeYear =
            heatmap.querySelector<HTMLElement>(".heatmap-badge-year")
          if (badgeYear) badgeYear.textContent = String(year)
          const titleYear =
            heatmap.querySelector<HTMLElement>(".heatmap-title-year")
          if (titleYear)
            titleYear.textContent =
              year === payload.currentYear ? "今年" : `${year} 年`
          const titleCount =
            heatmap.querySelector<HTMLElement>(".heatmap-title-count")
          if (titleCount) titleCount.textContent = String(yData.stats.total)
          const srDesc = heatmap.querySelector<HTMLElement>(
            ".heatmap-sr-description"
          )
          if (srDesc)
            srDesc.textContent =
              srDesc.textContent?.replace(/\d{4}/, String(year)) ?? ""

          // 统计卡
          setStat("activeDays", yData.stats.activeDays)
          setStat("longestStreak", yData.stats.longestStreak)
          setStat("busiestCount", yData.stats.busiestCount)

          // 明细表按月重建
          const caption = heatmap.querySelector(".heatmap-table caption")
          if (caption)
            caption.textContent = `${year} 年有文章发布的日期`
          const tbody = heatmap.querySelector<HTMLElement>(
            ".heatmap-table tbody"
          )
          if (tbody)
            tbody.innerHTML = monthSummariesHTML(summarizeByMonth(cells))
        }

        select?.addEventListener("change", () =>
          renderYear(Number(select.value))
        )

        grids.forEach((grid) => {
          grid.addEventListener("pointerover", (event) => {
            const cell = (event.target as HTMLElement).closest<HTMLElement>(
              ".heatmap-cell[data-date]"
            )
            if (cell) showTooltip(cell)
          })

          grid.addEventListener("pointermove", () => {
            if (activeCell) positionTooltip(activeCell)
          })

          grid.addEventListener("pointerdown", (event) => {
            if (event.pointerType !== "touch") return
            const cell = (event.target as HTMLElement).closest<HTMLElement>(
              ".heatmap-cell[data-date]"
            )
            if (!cell) return
            showTooltip(cell)
            window.setTimeout(hideTooltip, 2500)
          })

          grid.addEventListener("pointerleave", hideTooltip)
          grid.addEventListener("focusin", (event) => {
            const cell = (event.target as HTMLElement).closest<HTMLElement>(
              ".heatmap-cell[data-date]"
            )
            if (cell) showTooltip(cell)
          })
          grid.addEventListener("focusout", hideTooltip)
        })
      })
  }

  initializeHeatmaps()
  document.addEventListener("astro:page-load", initializeHeatmaps)
</script>
