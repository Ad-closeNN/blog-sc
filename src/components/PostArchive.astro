---
import PostArchiveItem from "@/components/PostArchiveItem.astro"
import { groupPostsByYear, type Post } from "@/lib/posts"

type Props = {
  posts: Post[]
}

const { posts } = Astro.props
// 真置顶：置顶文章从年份分组里拆出、固定在最前（与首页 PostTimeline 同思路）。
const pinnedPosts = posts.filter((post) => post.data.pinned)
const regularPosts = posts.filter((post) => !post.data.pinned)
const groups = groupPostsByYear(regularPosts)
---

{
  posts.length === 0 ? (
    <p class="archive-empty">暂无文章。</p>
  ) : (
    <div class="post-archive">
      {pinnedPosts.length > 0 && (
        <section class="post-archive-year is-pinned" aria-label="置顶文章">
          <header class="post-archive-year-header">
            <h2>置顶</h2>
            <span class="post-archive-rail" aria-hidden="true">
              <span class="post-archive-year-marker" />
            </span>
            <span class="post-archive-count">{pinnedPosts.length} 篇</span>
          </header>

          <ol class="post-archive-list">
            {pinnedPosts.map((post) => (
              <PostArchiveItem post={post} />
            ))}
          </ol>
        </section>
      )}

      {groups.map((group) => (
        <section
          class="post-archive-year"
          aria-labelledby={`archive-year-${group.year}`}
        >
          <header class="post-archive-year-header">
            <h2 id={`archive-year-${group.year}`}>{group.year}</h2>
            <span class="post-archive-rail" aria-hidden="true">
              <span class="post-archive-year-marker" />
            </span>
            <span class="post-archive-count">{group.posts.length} 篇</span>
          </header>

          <ol class="post-archive-list">
            {group.posts.map((post) => (
              <PostArchiveItem post={post} />
            ))}
          </ol>
        </section>
      ))}
    </div>
  )
}
