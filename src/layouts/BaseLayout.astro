---
import { ClientRouter } from "astro:transitions"
import ImageLightbox from "@/components/ImageLightbox.astro"
import RouteProgressScripts from "@/components/RouteProgressScripts.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import SiteNavbar from "@/components/SiteNavbar.astro"
import type { Heading } from "@/components/TableOfContents"
import { gaConfig, site, umamiConfig } from "@/config"
import { publicPath } from "@/lib/posts"
import "@/styles/global.css"

type Props = {
  title?: string
  description?: string
  ogType?: "website" | "article"
  publishedTime?: Date | string
  modifiedTime?: Date | string
  tags?: string[]
  mainClass?: string
  showFooter?: boolean
  headings?: Heading[]
  /** 面包屑末段显示文本（slug → 原文，如 tag/category 名） */
  breadcrumbLabel?: string
  /** 文章页：h1 滚出 navbar 后，面包屑末段从 slug 顶替为该标题 */
  navbarSwapTitle?: string
  /** 图片路径（/images/...），用于 og:image / twitter:image */
  ogImage?: string
  /** 搜索引擎索引策略：true 时不索引该页 */
  noindex?: boolean
  /** 页面级 JSON-LD 结构化数据（单个对象或多个对象数组，数组用 @graph 包裹） */
  jsonLd?: object | object[]
}

const pathname = Astro.url.pathname
const isHome = pathname === "/"

const title = isHome
  ? site.name
  : Astro.props.title
    ? `${Astro.props.title} | ${site.name}`
    : site.name
const description = Astro.props.description ?? site.description
const showFooter = Astro.props.showFooter ?? true
const ogType = Astro.props.ogType ?? "website"
const tags = Astro.props.tags ?? []
const canonicalUrl = new URL(pathname, site.url).toString()

function toIso(value: Date | string) {
  return value instanceof Date
    ? value.toISOString()
    : new Date(value).toISOString()
}

const publishedTime = Astro.props.publishedTime
  ? toIso(Astro.props.publishedTime)
  : null
const modifiedTime = Astro.props.modifiedTime
  ? toIso(Astro.props.modifiedTime)
  : null
const noindex = Astro.props.noindex ?? false
const jsonLd = Astro.props.jsonLd
const ogImageAbs = Astro.props.ogImage
  ? new URL(publicPath(Astro.props.ogImage), site.url).toString()
  : null
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(
            Array.isArray(jsonLd)
              ? { "@context": "https://schema.org", "@graph": jsonLd }
              : jsonLd
          )}
        />
      )
    }
    <link rel="icon" type="image/jpeg" href={site.avatarSrc} />
    <link rel="apple-touch-icon" href={site.avatarSrc} />
    <!-- MiSans 简繁中文 WebFont (来自 ProjectK-Web) -->
    <link rel="stylesheet" href="/fonts/misans-web-vf-font/MiSans.min.css" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta
      name="twitter:card"
      content={ogImageAbs ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

    <script is:inline>
      ;(() => {
        const key = "theme"
        const resolveDark = () => {
          const stored = localStorage.getItem(key)
          return (
            stored === "dark" ||
            (!stored &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)
          )
        }
        // 幂等：把主题套到给定文档的 <html> 上
        const applyTheme = (doc) => {
          doc.documentElement.classList.toggle("dark", resolveDark())
        }
        // 首次整页加载
        applyTheme(document)
        // 客户端导航（View Transitions）：swap 前把主题套到新文档，
        // 否则 SSR 产物里的 <html> 不带 .dark，切页后会变回亮色
        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(event.newDocument)
        })
      })()
    </script>
    <RouteProgressScripts />
    <ClientRouter />
    <script is:inline>
      ;(() => {
        const installKey = "__siteNavbarScrolledInstalled"
        if (window[installKey]) return
        window[installKey] = true

        // navbar 高度 48px；哨兵滚入 navbar 覆盖区时启用毛玻璃，
        // 贴顶（哨兵仍在 navbar 下方可见）时保持纯色背景，省去常驻合成层
        const navSelector = ".site-navbar"
        const sentinelSelector = ".site-navbar-sentinel"
        let observer = null

        const setup = () => {
          const nav = document.querySelector(navSelector)
          const sentinel = document.querySelector(sentinelSelector)
          if (!nav || !sentinel) return

          if (observer) observer.disconnect()

          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                nav.classList.toggle("is-scrolled", !entry.isIntersecting)
              }
            },
            { rootMargin: "-48px 0px 0px 0px", threshold: 0 }
          )
          observer.observe(sentinel)
        }

        document.addEventListener("astro:page-load", setup)
        setup()
      })()
    </script>
    <script is:inline>
      ;(() => {
        // 文章页 slug ↔ 标题互换：h1 底边滚出 navbar 下沿时，
        // 面包屑末段 slug 向左滑出、文章标题从右滑入；滚回则反向。
        // 复用 is-scrolled 的 installKey + astro:page-load re-setup 模式。
        const installKey = "__siteNavbarTitleSwapInstalled"
        if (window[installKey]) return
        window[installKey] = true

        const navSelector = ".site-navbar"
        const h1Selector = ".article-header h1"
        let observer = null

        const setup = () => {
          const nav = document.querySelector(navSelector)
          const h1 = document.querySelector(h1Selector)
          // 只在文章页激活：navbar 有双层互换结构 + 页面有 h1
          if (!nav || !h1 || !nav.querySelector(".site-navbar-current-title"))
            return

          if (observer) observer.disconnect()
          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                const gone = !entry.isIntersecting
                nav.classList.toggle("is-title-gone", gone)
                const slug = nav.querySelector(".site-navbar-current-slug")
                const title = nav.querySelector(".site-navbar-current-title")
                if (slug) slug.setAttribute("aria-hidden", String(gone))
                if (title) title.setAttribute("aria-hidden", String(!gone))
              }
            },
            { rootMargin: "-48px 0px 0px 0px", threshold: 0 }
          )
          observer.observe(h1)
        }

        document.addEventListener("astro:page-load", setup)
        setup()
      })()
    </script>

    {
      umamiConfig.enable && umamiConfig.websiteId && (
        <script
          async
          src={`${umamiConfig.baseUrl}/script.js`}
          data-website-id={umamiConfig.websiteId}
        />
      )
    }
    <!-- Google Analytics (GA4)。
         走 View Transitions，所以 send_page_view:false + 在 astro:page-load
         手动上报 page_view（该事件首屏也会触发），保证每页恰好一次、切页不漏报。 -->
    <script is:inline define:vars={{ gaConfig }}>
      {
        /* eslint-disable */
        if (gaConfig.enable && gaConfig.measurementId) {
          window.dataLayer = window.dataLayer || []
          if (!window.gtag) {
            window.gtag = function () {
              window.dataLayer.push(arguments)
            }
          }
          if (!window.__gaLoaded) {
            window.__gaLoaded = true
            const gaScript = document.createElement("script")
            gaScript.async = true
            gaScript.src =
              "https://www.googletagmanager.com/gtag/js?id=" +
              gaConfig.measurementId
            document.head.appendChild(gaScript)
            window.gtag("js", new Date())
            window.gtag("config", gaConfig.measurementId, {
              send_page_view: false,
            })
          }
          if (!window.__gaBound) {
            window.__gaBound = true
            document.addEventListener("astro:page-load", function () {
              window.gtag("event", "page_view", {
                page_location: window.location.href,
                page_path: window.location.pathname,
                page_title: document.title,
              })
            })
          }
        }
        /* eslint-enable */
      }
    </script>

    <!-- __blogUmami store：SidebarStats / PostViews 读统计用。
         必须走 define:vars 注入 umamiConfig：is:inline 不做插值，
         直接写 umamiConfig.xxx 会在运行时 ReferenceError。 -->
    <script is:inline define:vars={{ umamiConfig }}>
      {
        /* eslint-disable */
        const __umamiCfg = {
          enable: umamiConfig.enable === true,
          baseUrl: umamiConfig.baseUrl,
          shareId: umamiConfig.shareId,
          timezone: umamiConfig.timezone,
        }
        window["__blogUmami"] = window["__blogUmami"] || {
          baseUrl: __umamiCfg.baseUrl,
          timezone: __umamiCfg.timezone,
          shareDataPromise: null,
          // 只保留「同一次渲染内并发去重」的 promise 缓存，不缓存结果值：
          // store 挂在 window 上、View Transitions 切页不会重建，
          // 若缓存结果值则切页回来会显示旧浏览量。
          statsPromiseCache: new Map(),
          async getShareData() {
            if (!__umamiCfg.enable) return null
            if (this.shareDataPromise) return this.shareDataPromise
            this.shareDataPromise = fetch(
              `${__umamiCfg.baseUrl}/api/share/${__umamiCfg.shareId}`
            )
              .then((response) => {
                if (!response.ok) throw new Error("获取分享信息失败")
                return response.json()
              })
              .catch((error) => {
                this.shareDataPromise = null
                throw error
              })
            return this.shareDataPromise
          },
          async getStats(cacheKey, buildStatsUrl) {
            if (this.statsPromiseCache.has(cacheKey))
              return this.statsPromiseCache.get(cacheKey)
            const requestPromise = new Promise((resolve, reject) => {
              const doFetch = () => {
                this.getShareData()
                  .then(async (shareData) => {
                    if (!shareData) {
                      resolve(null)
                      return
                    }
                    const statsUrl = buildStatsUrl(shareData.websiteId)
                    const statsResponse = await fetch(statsUrl, {
                      headers: { "x-umami-share-token": shareData.token },
                    })
                    if (!statsResponse.ok) throw new Error("获取统计数据失败")
                    const statsData = await statsResponse.json()
                    this.statsPromiseCache.delete(cacheKey)
                    resolve(statsData)
                  })
                  .catch((error) => {
                    this.statsPromiseCache.delete(cacheKey)
                    reject(error)
                  })
              }
              if ("requestIdleCallback" in window) {
                requestIdleCallback(doFetch, { timeout: 3000 })
              } else {
                setTimeout(doFetch, 3000)
              }
            })
            this.statsPromiseCache.set(cacheKey, requestPromise)
            return requestPromise
          },
        }
        /* eslint-enable */
      }
    </script>
  </head>
  <body>
    <div class="route-progress" aria-hidden="true">
      <div class="route-progress-track">
        <div class="route-progress-bar"></div>
      </div>
    </div>
    <!-- 哨兵：位于 navbar 下沿，用来判断内容是否已滚入 navbar 覆盖区 -->
    <div class="site-navbar-sentinel" aria-hidden="true"></div>
    <SiteNavbar
      pathname={pathname}
      headings={Astro.props.headings}
      currentLabel={Astro.props.breadcrumbLabel}
      navbarSwapTitle={Astro.props.navbarSwapTitle}
    />
    <main class={Astro.props.mainClass}>
      <slot />
    </main>
    {showFooter && <SiteFooter />}
    <ImageLightbox />
  </body>
</html>
